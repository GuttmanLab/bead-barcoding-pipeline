def derive_num_tags(format_file):
    """
    Derive num_tags automatically from the barcode format file.

    Each line of the barcode format file is a comma-separated list of tag
    groups that together make up one valid barcode.

    num_tags is the count of tags on each line: the BPM read-type tag + (optional)
    DPM read-type tag (identified on read 1) plus split-and-pool round tags 
    (including the terminal "Y" tag) + (optional) RPM read-type tag (identified on
    read 2)
    """
    with open(format_file) as f:
        lines = [line.strip() for line in f if line.strip()]
    if not lines:
        print(f"Barcode format file is empty: {format_file}", file=sys.stderr)
        sys.exit()
    counts = set()
    for line in lines:
        tags = [t.strip() for t in line.split(",") if t.strip()]
        counts.add(len(tags))
    if len(counts) != 1:
        print(
            "Inconsistent number of tags across lines in barcode format file "
            f"{format_file}: found line lengths {sorted(counts)}. Every line "
            "must specify the same number of tags.",
            file=sys.stderr,
        )
        sys.exit()
    return counts.pop()

num_tags = derive_num_tags(barcode_format)
print("Derived", num_tags, "tags from barcode format file:", barcode_format, file=sys.stderr)

def get_conda_env(default_env_yaml):
    """
    Resolve which conda environment a rule's `conda:` directive should use.

    If the optional `conda_env` key is set in config.yaml, it is used instead
    of `default_env_yaml`, allowing a single persistent conda environment to
    be built once (e.g. `conda env create -f workflow/envs/pipeline.yaml`)
    and reused across many working directories/experiments, instead of
    Snakemake creating a fresh environment from `default_env_yaml` every time.
    `conda_env` may be either:
      - the name of an existing conda environment (as listed by
        `conda env list`), or
      - a path to an already-built conda environment directory (i.e., a
        directory containing a `conda-meta` subdirectory).

    If `conda_env` is not set (the default), falls back to `default_env_yaml`
    -- Snakemake's normal per-rule environment-creation behavior.

    Args
    - default_env_yaml: str
        Path to the environment YAML file this rule uses if conda_env is not set.

    Returns
    - str: either default_env_yaml unchanged, or a resolved path to an
      existing conda environment.
    """
    conda_env = config.get("conda_env")
    if not conda_env:
        return default_env_yaml

    # Case 1: a path to an already-built environment directory
    if os.sep in conda_env or os.path.isdir(conda_env):
        if not os.path.isdir(os.path.join(conda_env, "conda-meta")):
            print(
                f"conda_env is set to '{conda_env}', which does not look like a "
                "built conda environment directory (no conda-meta subdirectory "
                "found there). Check the path, or unset conda_env in config.yaml "
                "to let Snakemake build environments automatically instead.",
                file=sys.stderr,
            )
            sys.exit()
        return conda_env

    # Case 2: the name of an existing named conda environment
    try:
        result = subprocess.run(
            ["conda", "env", "list", "--json"],
            capture_output=True, text=True, check=True,
        )
        env_paths = json.loads(result.stdout).get("envs", [])
    except (subprocess.CalledProcessError, FileNotFoundError, json.JSONDecodeError) as e:
        print(
            f"Could not query conda environments to resolve conda_env='{conda_env}': {e}",
            file=sys.stderr,
        )
        sys.exit()

    matches = [p for p in env_paths if os.path.basename(p) == conda_env]
    if not matches:
        available = [os.path.basename(p) for p in env_paths]
        print(
            f"conda_env is set to '{conda_env}', but no conda environment with "
            f"that name was found. Available environments: {available}",
            file=sys.stderr,
        )
        sys.exit()
    return matches[0]

