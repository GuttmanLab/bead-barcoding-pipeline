# Send and email if an error occurs during execution
onerror:
    if email not in (None, ""):
        shell('mail -s "an error occurred" ' + email + ' < {log}')

wildcard_constraints:
    sample = r"[^\.]+",
    target = "|".join([re.escape(x) for x in TARGETS])

# Output all snakemake configuration parameters into logs folder with run date
rule log_config:
    output:
        CONFIG
    run:
        with open(output[0], "wt") as f:
            json.dump(config, f, indent=4, sort_keys=True)

##############################################################################
# Trimming and barcode identification
##############################################################################

# Split fastq files into chunks to processes in parallel
rule split_fastq:
    wildcard_constraints:
        read="R1|R2"
    input:
        lambda wildcards: FILES[wildcards.sample][wildcards.read],
    output:
        expand(os.path.join(DIR_OUT, "split_fastq", "{{sample}}_{{read}}.part_{splitid}.fastq.gz"),splitid=NUM_CHUNKS)
    log:
        os.path.join(DIR_LOGS, "split_fastq.{sample}.{read}.log")
    params:
        outstring = ' '.join(expand("-o " + os.path.join(DIR_OUT, "split_fastq", "{{sample}}_{{read}}.part_{splitid}.fastq.gz"), splitid=NUM_CHUNKS))  
    conda:
        get_conda_env("envs/pipeline.yaml")
    threads:
        8
    shell:
        '''
        fastqsplitter -i {input} {params.outstring} -t {threads}
        '''

# Trim adaptors
rule adaptor_trimming:
    input:
        [os.path.join(DIR_OUT, "split_fastq", "{sample}_R1.part_{splitid}.fastq.gz"),
         os.path.join(DIR_OUT, "split_fastq", "{sample}_R2.part_{splitid}.fastq.gz")]
    output:
         os.path.join(DIR_OUT, "trimmed", "{sample}_R1.part_{splitid}_val_1.fq.gz"),
         os.path.join(DIR_OUT, "trimmed", "{sample}_R1.part_{splitid}.fastq.gz_trimming_report.txt"),
         os.path.join(DIR_OUT, "trimmed", "{sample}_R2.part_{splitid}_val_2.fq.gz"),
         os.path.join(DIR_OUT, "trimmed", "{sample}_R2.part_{splitid}.fastq.gz_trimming_report.txt")
    log:
        os.path.join(DIR_LOGS, "adaptor_trimming.{sample}.{splitid}.log")
    params:
        dir = os.path.join(DIR_OUT, "trimmed")
    conda:
        get_conda_env("envs/pipeline.yaml")
    threads:
        10
    shell:
        '''
        if [[ {threads} -gt 8 ]]; then
            cores=2
        else
            cores=1
        fi

        trim_galore \\
          --paired \\
          --gzip \\
          --cores $cores \\
          --quality 20 \\
          --fastqc \\
          -o "{params.dir}" \\
          {input:q} &> "{log}"
        '''

# Identify barcodes using splitcode
rule barcode_id:
    input:
        r1 = os.path.join(DIR_OUT, "trimmed", "{sample}_R1.part_{splitid}_val_1.fq.gz"),
        r2 = os.path.join(DIR_OUT, "trimmed", "{sample}_R2.part_{splitid}_val_2.fq.gz")
    output:
        r1_barcoded = os.path.join(DIR_OUT, "fastqs", "{sample}_R1.part_{splitid}.barcoded.fastq.gz"),
        r2_barcoded = os.path.join(DIR_OUT, "fastqs", "{sample}_R2.part_{splitid}.barcoded.fastq.gz"),
        r1_unassigned = os.path.join(DIR_OUT, "fastqs", "{sample}_R1.part_{splitid}.unassigned.fastq.gz"),
        r2_unassigned = os.path.join(DIR_OUT, "fastqs", "{sample}_R2.part_{splitid}.unassigned.fastq.gz")
    params:
        mapping=os.path.join(DIR_OUT, "fastqs", "mapping.{sample}.{splitid}.txt")
    log:
        os.path.join(DIR_LOGS, "barcode_id.{sample}.{splitid}.log")
    conda:
        get_conda_env("envs/pipeline.yaml")
    shell:
        '''
        splitcode --assign -N 2 \\
          -o "{output.r1_barcoded}","{output.r2_barcoded}" \\
          --unassigned="{output.r1_unassigned}","{output.r2_unassigned}" \\
          -c "{barcode_config}" --keep-grp="{barcode_format}" \\
          --mod-names --mapping="{params.mapping}" --no-outb \\
          --gzip  "{input.r1}" "{input.r2}" &> "{log}"
        '''

# Calculate barcode identification efficiency
rule barcode_identification_efficiency:
    input:
        assigned = expand(os.path.join(DIR_OUT, "fastqs", "{{sample}}_R1.part_{splitid}.barcoded.fastq.gz"), splitid=NUM_CHUNKS),
        unassigned = expand(os.path.join(DIR_OUT, "fastqs", "{{sample}}_R1.part_{splitid}.unassigned.fastq.gz"), splitid=NUM_CHUNKS)
    output:
        os.path.join(DIR_OUT, "{sample}.bid_efficiency.txt")
    log:
        os.path.join(DIR_LOGS, "barcode_identification_efficiency.{sample}.log")
    conda:
        get_conda_env("envs/pipeline.yaml")
    shell:
        '''
        python "{barcode_identification_efficiency}" --assigned "{input.assigned}" --unassigned "{input.unassigned}" --config "{barcode_config}" --format "{barcode_format}" > "{output}" 2> "{log}"
        '''
        
if experiment_type in ("DNA", "ChIP-DIP"):
    # Split barcoded reads into BPM and DPM
    rule split_bpm_dpm:
        input:
            os.path.join(DIR_OUT, "fastqs", "{sample}_R1.part_{splitid}.barcoded.fastq.gz")
        output:
            os.path.join(DIR_OUT, "fastqs", "{sample}_R1.part_{splitid}.barcoded_dpm.fastq.gz"),
            os.path.join(DIR_OUT, "fastqs", "{sample}_R1.part_{splitid}.barcoded_bpm.fastq.gz"),
        log:
            os.path.join(DIR_LOGS, "split_bpm_dpm.{sample}.{splitid}.log")
        conda:
            get_conda_env("envs/pipeline.yaml")
        shell:
            '''
            python "{split_barcoded}" --input "{input}" --type "{experiment_type}" &> "{log}"
            '''
elif experiment_type in ("RNA", "SPIDR"):
    # Split barcoded reads into BPM and RPM, output R1 and R2 for rpm
    rule split_bpm_rpm:
        input:
            os.path.join(DIR_OUT, "fastqs", "{sample}_R1.part_{splitid}.barcoded.fastq.gz")
        output:
            os.path.join(DIR_OUT, "fastqs", "{sample}_R1.part_{splitid}.barcoded_rpm.fastq.gz"),
            os.path.join(DIR_OUT, "fastqs", "{sample}_R2.part_{splitid}.barcoded_rpm.fastq.gz"),
            os.path.join(DIR_OUT, "fastqs", "{sample}_R1.part_{splitid}.barcoded_bpm.fastq.gz"),
        log:
            os.path.join(DIR_LOGS, "split_bpm_rpm.{sample}.{splitid}.log")
        conda:
            get_conda_env("envs/pipeline.yaml")
        shell:
            '''
            python "{split_barcoded}" --input "{input}" --type "{experiment_type}" &> "{log}"
            '''

##############################################################################
# Cutadapt
##############################################################################

# Trim DPM readthrough from read1 of DPM reads, remove short reads (DPM dimer)
rule cutadapt_dpm:
    input:
        os.path.join(DIR_OUT, "fastqs", "{sample}_R1.part_{splitid}.barcoded_dpm.fastq.gz")
    output:
        fastq = os.path.join(DIR_OUT, "trimmed", "{sample}_R1.part_{splitid}.barcoded_dpm.RDtrim.fastq.gz"),
        qc = os.path.join(DIR_OUT, "trimmed", "{sample}_R1.part_{splitid}.barcoded_dpm.RDtrim.qc.txt")
    log:
        os.path.join(DIR_LOGS, "cutadapt_dpm.{sample}.{splitid}.log")
    params:
        adapters_r1 = "-a GATCGGAAGAG -a ATCAGCACTTA", 
        others = "--minimum-length 20"
    conda:
        get_conda_env("envs/pipeline.yaml")
    threads:
        10
    shell:
        '''
        {{
            cutadapt \\
              {params.adapters_r1} \\
              {params.others} \\
              -o "{output.fastq}" \\
              -j {threads} \\
              "{input}" > "{output.qc}"

            fastqc "{output.fastq}"
        }} &> "{log}"
        '''

# Trim rpm readthrough from read 1 and from end of read2
rule cutadapt_rpm:
    input:
        read1 = os.path.join(DIR_OUT, "fastqs", "{sample}_R1.part_{splitid}.barcoded_rpm.fastq.gz"),
        read2 = os.path.join(DIR_OUT, "fastqs", "{sample}_R2.part_{splitid}.barcoded_rpm.fastq.gz")
    output:
        read1 = os.path.join(DIR_OUT, "trimmed", "{sample}_R1.part_{splitid}.barcoded_rpm.RDtrim.fastq.gz"),
        read2 = os.path.join(DIR_OUT, "trimmed", "{sample}_R2.part_{splitid}.barcoded_rpm.RDtrim.fastq.gz"),
        qc = os.path.join(DIR_OUT, "trimmed", "{sample}_R1.part_{splitid}.barcoded_rpm.RDtrim.qc.txt")
    log:
        os.path.join(DIR_LOGS, "cutadapt_rpm.{sample}.{splitid}.log")
    params:
        adapters_r1 = "-a ATCAGCACTTAGCGTCAG",
        adapters_r2 = "-G CTGACGCTAAGTGCTGAT",
        others = "-q 20,20 --minimum-length 20"
    conda:
        get_conda_env("envs/pipeline.yaml")
    threads:
        10
    shell:
        '''
        {{
            cutadapt \\
              {params.adapters_r1} \\
              {params.adapters_r2} \\
              {params.others} \\
              -o "{output.read1}" \\
              -p "{output.read2}" \\
              -j {threads} \\
              "{input.read1}" "{input.read2}" > "{output.qc}"
            fastqc "{output.read1}"
        }} &> "{log}"
        '''

