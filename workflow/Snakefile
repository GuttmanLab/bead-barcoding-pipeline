# Align RPM reads to repeat genome
rule bowtie2_align_rna:
    input:
        fq1 = os.path.join(DIR_OUT, "trimmed", "{sample}_R1.part_{splitid}.barcoded_rpm.RDtrim.fastq.gz"),
        fq2 = os.path.join(DIR_OUT, "trimmed", "{sample}_R2.part_{splitid}.barcoded_rpm.RDtrim.fastq.gz")
    output:
        mapped = os.path.join(DIR_OUT, "alignments_parts", "{sample}.part_{splitid}.bowtie2.mapped.bam"),
        unmapped = os.path.join(DIR_OUT, "alignments_parts", "{sample}.part_{splitid}.bowtie2.unmapped.bam")
    log:
        os.path.join(DIR_LOGS, "bowtie2_align_rna.{sample}.{splitid}.log")
    conda:
        get_conda_env("envs/pipeline.yaml")
    threads:
        10
    resources:
        tmpdir=temp_dir
    shell:
        '''
        {{
            bowtie2 \\
              -p {threads} \\
              -t \\
              -x "{bowtie2_index}" \\
              -1 "{input.fq1}" -2 "{input.fq2}"  | \
            samtools view -b -h -F 4 -U "{output.unmapped}" - | 
            samtools sort -@ {threads} -T "$TMPDIR" -o "{output.mapped}"
        }} &> "{log}"
        '''

# Convert unaligned back to fastq
rule bam_to_fastq:
    input:
        os.path.join(DIR_OUT, "alignments_parts", "{sample}.part_{splitid}.bowtie2.unmapped.bam")
    output:
        r1 = os.path.join(DIR_OUT, "fastqs", "{sample}.part_{splitid}.bowtie2.unmapped_R1.fq.gz"),
        r2 = os.path.join(DIR_OUT, "fastqs", "{sample}.part_{splitid}.bowtie2.unmapped_R2.fq.gz")
    log:
        os.path.join(DIR_LOGS, "bam2fq.{sample}.{splitid}.log")
    conda:
        get_conda_env("envs/pipeline.yaml")
    threads:
        10
    resources:
        tmpdir=temp_dir
    shell:
        '''
        {{
            samtools sort -n -o - "{input}" | \
            samtools fastq -1 "{output.r1}" -2 "{output.r2}" -0 /dev/null -s /dev/null -n 
        }} &> "{log}"
        '''

# Align RPM reads to genome
rule star_align:
    input:
        r1 = os.path.join(DIR_OUT, "fastqs", "{sample}.part_{splitid}.bowtie2.unmapped_R1.fq.gz"),
        r2 = os.path.join(DIR_OUT, "fastqs", "{sample}.part_{splitid}.bowtie2.unmapped_R2.fq.gz")
    output:
        os.path.join(DIR_OUT, "alignments_parts", "{sample}.part_{splitid}.Aligned.sortedByCoord.out.bam")
    log:
        os.path.join(DIR_LOGS, "star_align.{sample}.{splitid}.log")
    params:
        star_options = "--readFilesCommand zcat --alignEndsType EndToEnd --outFilterScoreMin 10 --outFilterMultimapNmax 1 --outFilterMismatchNmax 10 --alignIntronMax 100000 --alignMatesGapMax 1300 --alignIntronMin 80 --alignSJDBoverhangMin 5 --alignSJoverhangMin 8 --chimSegmentMin 20 --alignSJstitchMismatchNmax 5 -1 5 5 --outSAMtype BAM SortedByCoordinate",
         prefix = os.path.join(DIR_OUT, "alignments_parts", "{sample}.part_{splitid}.")
    conda:
        get_conda_env("envs/pipeline.yaml")
    threads:
        10
    resources:
        tmpdir=temp_dir
    shell:
        '''
        {{
            STAR \\
              --genomeDir {star_index} \\
              --readFilesIn "{input.r1}" "{input.r2}" \\
              --runThreadN {threads} {params.star_options} \\
              --outFileNamePrefix {params.prefix} 
        }} &> "{log}"
        '''

# Rename chromosome names and filter for chromosomes of interest
rule rename_and_filter_chr_rna:
    input:
        star = os.path.join(DIR_OUT, "alignments_parts", "{sample}.part_{splitid}.Aligned.sortedByCoord.out.bam"),
    output:
        star = os.path.join(DIR_OUT, "alignments_parts", "{sample}.part_{splitid}.Aligned.sortedByCoord.out.chr.bam"),
    log:
        os.path.join(DIR_LOGS, "rename_and_filter_chr.{sample}.{splitid}.log")
    params:
        chrom_map = f"--chrom_map '{path_chrom_map}'" if path_chrom_map != "" else ""
    conda:
        get_conda_env("envs/pipeline.yaml")
    threads:
        4
    resources:
        tmpdir=temp_dir
    shell:
        '''
        {{
            python "{rename_and_filter_chr}" {params.chrom_map} -t {threads} --try-symlink \\
                -o "{output.star}" "{input.star}" 
        }} &> "{log}"
        '''

# Combine all mapped RNA reads into a single bam file per sample
rule merge_rna:
