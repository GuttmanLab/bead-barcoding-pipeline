def get_targets(barcode_config_file):
    df = pd.read_csv(
        barcode_config,
        sep="\t",
        header=0,
        comment="#",
        skip_blank_lines=True,
        on_bad_lines="error",
    )
    targets = [x.replace("BEAD_", "") for x in df["ids"] if "BEAD_" in x]
    return list(set(targets))
TARGETS = get_targets(barcode_config)

