##############################################################################
# Make clusters
##############################################################################

def get_cluster_input(wildcards):
    beads = os.path.join(DIR_OUT, "alignments_parts", "{sample}.part_{splitid}.BPM.bam")
    if experiment_type in ("DNA", "ChIP-DIP"):
        dna =  os.path.join(DIR_OUT, "alignments_parts", "{sample}.part_{splitid}.DNA.chr.masked.bam")
        return beads, dna
    elif experiment_type in ("RNA", "SPIDR"):
        rna1 =  os.path.join(DIR_OUT, "alignments_parts", "{sample}.part_{splitid}.bowtie2.mapped.bam")
        rna2 =  os.path.join(DIR_OUT, "alignments_parts", "{sample}.part_{splitid}.Aligned.sortedByCoord.out.chr.bam") 
        return beads, rna1, rna2

# Make clusters from aligned reads and oligo reads
rule make_clusters:
    input:
       get_cluster_input
    output:
        unsorted = temp(os.path.join(DIR_OUT, "clusters_parts", "{sample}.part_{splitid}.unsorted.clusters")),
        sorted = os.path.join(DIR_OUT, "clusters_parts", "{sample}.part_{splitid}.clusters")
    log:
        os.path.join(DIR_LOGS, "make_clusters.{sample}.{splitid}.log")
    conda:
        get_conda_env("envs/pipeline.yaml")
    threads:
        4
    resources:
        tmpdir=temp_dir
    shell:
        '''
        {{
            python "{make_clusters}" -i "{input}" -o "{output.unsorted}" -n {num_tags}

            sort -k 1 --parallel={threads} "{output.unsorted}" > "{output.sorted}"
        }} &> "{log}"
        '''

# Merge clusters from parallel processing into a single cluster file per sample
rule merge_clusters:
    input:
        expand(
            os.path.join(DIR_OUT, "clusters_parts", "{{sample}}.part_{splitid}.clusters"),
            splitid=NUM_CHUNKS)
    output:
        mega = temp(os.path.join(DIR_OUT, "clusters", "{sample}.duplicated.clusters")),
        final = os.path.join(DIR_OUT, "clusters", "{sample}.clusters")
    log:
        os.path.join(DIR_LOGS, "merge_clusters.{sample}.log")
    conda:
        get_conda_env("envs/pipeline.yaml")
    threads:
        10
    resources:
        tmpdir=temp_dir
    shell:
        '''
        {{
            sort -k 1 --parallel={threads} -m {input:q} > "{output.mega}"
            python "{merge_clusters}" -i "{output.mega}" -o "{output.final}"
        }} &> "{log}"
        '''

rule clusters_all:
    input:
        CLUSTERS_MERGED
    output:
        CLUSTERS_ALL
    log:
        os.path.join(DIR_LOGS, "clusters_all.log")
    threads:
        10
    resources:
        tmpdir=temp_dir
    shell:
        '''
        sort -k 1 --parallel={threads} -m {input:q} > "{output}" 2> "{log}"
        '''

